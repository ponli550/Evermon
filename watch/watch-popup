#!/usr/bin/env bash
# The live-triage board as a panvim view. Same invocation shape as
# pr-watch-ctl's own popup and hackager-popup: --render regenerates the
# board, --keys/--syntax are this project's own, --var supplies {ctl}/{log}
# for keys.tsv. Project-local -- run this directly, no global registration.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec panvim view --title sdoc-watch \
  --render "$HERE/watch-ctl board > \"\$PANVIM_OUT\" 2>&1" --interval 3 \
  --keys "$HERE/panel/keys.tsv" --syntax "$HERE/panel/syntax.tsv" \
  --state "$HERE/state" \
  --var "ctl=$HERE/watch-ctl" --var "log=$HERE/state/daemon.log"
