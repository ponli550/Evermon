#!/usr/bin/env bash
# Control surface for the SDOC live-triage daemon. Same shape as pr-watch-ctl:
# a background daemon, a state dir, a control script with start/stop/status,
# a live board, a live log. Project-local -- nothing here touches
# ~/.config or ~/.local/bin.
#
#   watch-ctl start            launch the daemon (background, PID tracked)
#   watch-ctl stop|restart
#   watch-ctl status           one-shot: running? pid? events seen?
#   watch-ctl board            the current triage board (for panvim --render)
#   watch-ctl log              tail the daemon log
#   watch-ctl feed [n] [--rate s] [--shuffle]   drip n sample emails in (demo)
#   watch-ctl reset            wipe live_inbox/ + state/ for a clean re-demo
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="$HERE/state"
PID_FILE="$STATE/daemon.pid"
LOG="$STATE/daemon.log"
BOARD="$STATE/board.txt"
PY="${PYTHON:-python3}"

mkdir -p "$STATE"

running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

cmd="${1:-}"; shift || true
case "$cmd" in
  start)
    if running; then echo "already running (pid $(cat "$PID_FILE"))"; exit 0; fi
    nohup "$PY" "$HERE/daemon.py" >>"$LOG" 2>&1 &
    disown
    sleep 0.3
    if running; then echo "started (pid $(cat "$PID_FILE"))"; else
      echo "failed to start -- see $LOG" >&2; exit 1
    fi
    ;;
  stop)
    if ! running; then echo "not running"; exit 0; fi
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    for _ in $(seq 1 20); do running || break; sleep 0.1; done
    running && kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "stopped"
    ;;
  restart)
    "$0" stop; "$0" start
    ;;
  status)
    n=0; [ -f "$STATE/events.jsonl" ] && n=$(wc -l < "$STATE/events.jsonl" | tr -d ' ')
    if running; then echo "running (pid $(cat "$PID_FILE")) -- $n email(s) triaged"
    else echo "stopped -- $n email(s) triaged"; fi
    ;;
  board)
    [ -f "$BOARD" ] && cat "$BOARD" || echo "# no board yet -- start the daemon and feed it"
    ;;
  log)
    touch "$LOG"; tail -n 60 -f "$LOG"
    ;;
  feed)
    "$PY" "$HERE/feeder.py" "$@"
    ;;
  reset)
    "$0" stop 2>/dev/null || true
    rm -f "$STATE"/*.jsonl "$STATE"/*.log "$STATE"/board.txt "$HERE"/live_inbox/inbox/email_*.json
    rm -rf "$HERE"/live_inbox/attachments/*
    echo "reset"
    ;;
  *)
    echo "usage: watch-ctl {start|stop|restart|status|board|log|feed [n]|reset}" >&2
    exit 1
    ;;
esac
