__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
submission.json
*.egg-info/
dist/
sdoc-hackathon-docker/

# watch/: a live-triage demo built on top of dock's own pipeline (not part of
# the graded batch deliverable in dock/ -- see watch/README.md). Runtime
# state and the fed-in copies of sample emails are not source.
watch/state/*.jsonl
watch/state/*.log
watch/state/*.pid
watch/state/board.txt
watch/live_inbox/inbox/*.json
watch/live_inbox/attachments/*
!watch/live_inbox/inbox/.gitkeep
!watch/live_inbox/attachments/.gitkeep
!watch/state/.gitkeep
.DS_Store
# watch/*-ctl, watch/*-popup: compiled Go binaries (go.mod+main.go are the
# tracked source); watch/state/view.txt: panvim's own render cache.
watch/watch-ctl
watch/watch-popup
watch/state/view.txt

# web-demo/: the hosted Cloudflare demo (not the graded pipeline either --
# see web-demo's own README). node_modules and wrangler's local dev state
# are not source; public/app.js is esbuild output, rebuilt by `npm run
# build`/`npm run deploy` from src/ -- not source either.
web-demo/node_modules/
web-demo/.wrangler/
web-demo/public/app.js
web-demo/public/app.js.map

# docs/media/: raw and rendered demo-video footage. Large binaries, not
# source, and not something to push -- the video itself gets uploaded
# wherever the submission form actually wants it, not committed here.
docs/media/

# Office lock files, dropped by whatever auto-opens docs/*.pptx on save.
~$*.pptx
~$*.docx
~$*.xlsx
